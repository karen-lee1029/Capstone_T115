{
  "datasets": [
    {
      "name": "b798cf1c",
      "displayName": "student_attrition_risk_prediction",
      "config": {
        "version": "1.1",
        "source": "workspace.student_aggregate.student_attrition_risk_prediction",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "risk_level",
            "expr": "CASE\n  WHEN source.attrition_risk_percentage >= 50 THEN 'At Risk'\n  ELSE 'Not At Risk'\nEND",
            "displayName": "Risk Level"
          },
          {
            "name": "risk_score_bucket",
            "expr": "CASE\n  WHEN source.attrition_risk_percentage < 46 THEN '0-46%'\n  WHEN source.attrition_risk_percentage < 48 THEN '46-48%'\n  WHEN source.attrition_risk_percentage < 49 THEN '48-49%'\n  WHEN source.attrition_risk_percentage < 50 THEN '49-50%'\n  WHEN source.attrition_risk_percentage < 51 THEN '50-51%'\n  WHEN source.attrition_risk_percentage < 52 THEN '51-52%'\n  WHEN source.attrition_risk_percentage < 54 THEN '52-54%'\n  ELSE '54-100%'\nEND",
            "displayName": "Risk Score Range"
          },
          {
            "name": "student_id",
            "expr": "LEFT(source.student_deidentified_hash, 16)",
            "displayName": "Student ID (de-identified)"
          },
          {
            "name": "risk_pct",
            "expr": "CAST(FLOOR(source.attrition_risk_percentage * 10) AS DOUBLE) / 10",
            "displayName": "Risk %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "scored_date",
            "expr": "CAST(source.scored_at AS DATE)",
            "displayName": "Scored Date",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(DISTINCT source.student_deidentified_hash)",
            "comment": "Count of unique students by deidentified hash",
            "displayName": "Student Count"
          }
        ]
      }
    },
    {
      "name": "student_enrolment",
      "displayName": "Student Enrolment Details",
      "config": {
        "source": "SELECT\n  student_deidentified_hash,\n  curriculum_item_title,\n  curriculum_item_type,\n  study_mode,\n  attendance_mode,\n  study_area_b_key,\n  course_key,\n  student_gender,\n  age_band,\n  international_domestic_student,\n  socioeconomic_status,\n  student_is_first_nations_student,\n  student_home_language,\n  citizenship_country,\n  student_birth_country,\n  commencing_continuing,\n  enrolment_year,\n  status,\n  stage\nFROM (\n  SELECT\n    e.*,\n    ROW_NUMBER() OVER (PARTITION BY e.student_deidentified_hash ORDER BY e.census_date DESC, e.enrolment_year DESC) as rn\n  FROM workspace.student_aggregate.rpt_student_management__fact__all_enrolment_eftsl__deidentified e\n) t\nWHERE t.rn = 1",
        "measures": [
          {
            "name": "student_count",
            "expr": "COUNT(*)",
            "displayName": "Student Count"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "student_deidentified_hash",
            "expr": "source.student_deidentified_hash"
          },
          {
            "name": "faculty",
            "expr": "study_area.owning_faculty_organisation_name",
            "displayName": "Faculty"
          },
          {
            "name": "program",
            "expr": "source.curriculum_item_title",
            "displayName": "Program"
          },
          {
            "name": "study_mode",
            "expr": "source.study_mode",
            "displayName": "Study Mode"
          },
          {
            "name": "attendance_mode",
            "expr": "source.attendance_mode",
            "displayName": "Attendance Mode"
          },
          {
            "name": "gender",
            "expr": "source.student_gender",
            "displayName": "Gender"
          },
          {
            "name": "age_band",
            "expr": "source.age_band",
            "displayName": "Age Band"
          },
          {
            "name": "international_domestic",
            "expr": "source.international_domestic_student",
            "displayName": "International/Domestic"
          },
          {
            "name": "socioeconomic_status",
            "expr": "source.socioeconomic_status",
            "displayName": "Socioeconomic Status"
          },
          {
            "name": "first_nations",
            "expr": "source.student_is_first_nations_student",
            "displayName": "First Nations"
          },
          {
            "name": "home_language",
            "expr": "source.student_home_language",
            "displayName": "Home Language"
          },
          {
            "name": "commencing_continuing",
            "expr": "source.commencing_continuing",
            "displayName": "Commencing/Continuing"
          },
          {
            "name": "enrolment_status",
            "expr": "source.status",
            "displayName": "Enrolment Status"
          }
        ],
        "joins": [
          {
            "name": "study_area",
            "source": "workspace.student_aggregate.dwh_curriculum__study_area_b",
            "on": "source.study_area_b_key = study_area.study_area_b_key"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "student_attrition_risk_prediction",
          "datasetName": "b798cf1c"
