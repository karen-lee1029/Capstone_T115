      "relationships": [
        {
          "name": "relationship_0",
          "from": "student_attrition_risk_prediction",
          "to": "Student_Enrolment_Details",
          "on": "`student_attrition_risk_prediction`.`student_deidentified_hash` = `Student_Enrolment_Details`.`student_deidentified_hash`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
  ],
